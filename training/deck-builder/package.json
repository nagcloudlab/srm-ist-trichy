{
  "name": "gan-mastery-decks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode u1-genai-gans",
    "check": "tsc --noEmit && vite build --ssr scripts/smoke.tsx --outDir .smoke --emptyOutDir --logLevel warn && node .smoke/smoke.js",
    "build": "npm run check && node scripts/publish.mjs",
    "publish": "node scripts/publish.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
